# Copy to .env on the VPS. Replace every placeholder locally; never commit .env.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tungocvan.com
# Generate once with `docker compose run --rm app php artisan key:generate --show`;
# save the resulting value in the VPS .env and never rotate it without a migration plan.
APP_KEY=PASTE_EXISTING_OR_GENERATED_KEY_HERE
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=inafo_pharma
DB_USERNAME=inafo_pharma
DB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME_DIFFERENT_ROOT_PASSWORD
CACHE_STORE=redis
SESSION_DRIVER=database
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
BROADCAST_CONNECTION=socket.io
NODEJS_SERVER_URL=http://socket:6001
NODEJS_SERVER_PORT=6001
BRIDGE_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
VITE_SOCKET_PUBLIC_URL=https://tungocvan.com
VITE_SOCKET_DEBUG=false
REALTIME_ALLOWED=true
REALTIME_ENABLED=true
SOCKET_HEALTH_URL=http://socket:6001/health
SOCKET_HEALTH_TIMEOUT=2
SESSION_DOMAIN=.tungocvan.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
